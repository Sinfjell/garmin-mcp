# Copy to .env (or export in your shell) if you want non-interactive login
# instead of running `garmin-mcp-auth` interactively.

# Auth mode: "session" (default) uses the unofficial garminconnect email/password
# token cache. "oauth" uses the official Garmin Connect Developer Program
# OAuth 2.0 PKCE path (Health + Activity APIs only). Leave unset / "session"
# for existing deployments — oauth is a separate eval/prod-candidate instance.
GARMIN_AUTH_MODE=session

# Garmin Connect email + password. Only needed for the initial login or if
# the cached token expires and you want the server to re-auth on its own
# (MFA accounts should use `garmin-mcp-auth` instead, since MFA needs a
# one-time interactive code). Ignored when GARMIN_AUTH_MODE=oauth.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where session tokens are cached after login. Defaults to ~/.garminconnect
# if unset — you normally don't need to set this.
GARMIN_TOKENS=

# Multi-tenant hosting only: a directory of per-user token stores, one
# subdirectory per user ID, served as <prefix>/<user-id>/mcp. Leave unset for
# normal single-account use — setting it changes how every request is routed.
# The env credentials above are never used for a tenant request.
GARMIN_MULTI_TENANT_ROOT=

# Onboarding app only: the public origin the connector URLs are built from,
# e.g. https://mcp.productivitytech.io, and the path prefix the MCP endpoints hang
# off (defaults to /u). These only affect the URL shown to the user.
GARMIN_CONNECTOR_BASE_URL=
GARMIN_CONNECTOR_PREFIX=

# ---------------------------------------------------------------------------
# Official OAuth (GARMIN_AUTH_MODE=oauth) — separate instance / port only.
# Never commit real values. Create the eval app in the Garmin developer portal
# and store Client ID/Secret in 1Password.
# ---------------------------------------------------------------------------
GARMIN_OAUTH_CLIENT_ID=
GARMIN_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the eval app.
GARMIN_OAUTH_REDIRECT_URI=https://mcp.productivitytech.io/garmin-oauth/callback
# Public origin: issuer of the MCP authorization server and base of the connector URL.
# Also derives the Host header allowlist for FastMCP DNS-rebinding protection
# (so nginx can forward Host: productivitytech.io without a 421 Invalid Host).
GARMIN_OAUTH_PUBLIC_BASE_URL=https://mcp.productivitytech.io
# Optional comma-separated extra Host values (e.g. www) beyond PUBLIC_BASE_URL.
# Localhost Host patterns are always kept for direct curls to the bind.
# GARMIN_OAUTH_ALLOWED_HOSTS=www.productivitytech.io
# EU-local disk path for per-user OAuth token files (directories 0700, files 0600).
# Defaults to ~/.garmin-oauth-tokens. No US-only cloud dependency.
GARMIN_OAUTH_TOKEN_ROOT=
# URL prefix for authorize/callback/webhooks/MCP (default /garmin-oauth).
GARMIN_OAUTH_PATH_PREFIX=/garmin-oauth
# Secret path segment for the Ping/Push URLs (>= 32 chars, no "/"). When set,
# register <prefix>/webhooks/<secret>/ping and .../push in the Garmin portal;
# the bare /webhooks/ping|push paths then return 404. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
GARMIN_OAUTH_WEBHOOK_SECRET=
# Shown on the consent page. Defaults: the Garmin section of the productivitytech.io
# privacy policy, and Fjellestad AS as operator.
# GARMIN_OAUTH_PRIVACY_URL=https://productivitytech.io/privacy-policy/#garmin-data
# GARMIN_OAUTH_OPERATOR=Fjellestad AS
